# Copy to .env and fill in only what you need. Defaults work without any of these.
# Never commit a filled-in .env: it is git-ignored on purpose.

# --- Destination -------------------------------------------------------------
DESTINATION_NAME=Singapore
DESTINATION_CURRENCY=SGD

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1100
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
# Similarity below this is treated as "not in the knowledge base".
RETRIEVAL_MIN_SCORE=0.32

# --- LLM ---------------------------------------------------------------------
# auto | openai | google | anthropic | ollama | template
# "auto" uses the first provider below that has a key; with none set, answers are
# composed directly from retrieved passages and MCP results (clearly labelled).
LLM_PROVIDER=auto
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

OPENAI_API_KEY=
# For Azure OpenAI or another OpenAI-compatible gateway:
OPENAI_BASE_URL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- MCP ---------------------------------------------------------------------
MCP_TOOL_TIMEOUT_SECONDS=20

# --- Conversation ------------------------------------------------------------
HISTORY_TURNS=6
